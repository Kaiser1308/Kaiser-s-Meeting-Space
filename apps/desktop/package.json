{
  "name": "@kms/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "dev:electron": "vite",
    "build:electron": "tsc --noEmit && vite build && electron-builder",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:windows": "node ../../scripts/windows/windows-test-cli.mjs",
    "test:smoke": "vitest run src/main/packaged-app.smoke.test.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@kms/native-contract": "workspace:*",
    "@kms/domain": "workspace:*",
    "@kms/translation": "workspace:*",
    "@vitejs/plugin-react": "^5.0.2",
    "keytar": "7.9.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "vite": "^7.1.3"
  },
  "devDependencies": {
    "@types/react": "^19.1.11",
    "@types/react-dom": "^19.1.7",
    "electron": "^34.0.2",
    "electron-builder": "^25.1.8",
    "@playwright/test": "^1.63.0",
    "typescript": "^5.9.2",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.5"
  }
}
