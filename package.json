{
  "name": "kaiser-meeting-space",
  "private": true,
  "version": "0.1.0",
  "main": "apps/mobile/index.js",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "dev:api": "pnpm --filter @kms/api dev",
    "dev:desktop": "pnpm --filter @kms/desktop dev",
    "dev:mobile": "pnpm --filter @kms/mobile start",
    "execution:generate": "node scripts/execution/generate-phase-prompts.mjs",
    "execution:generate:check": "node scripts/execution/generate-phase-prompts.mjs --check",
    "execution:check": "node scripts/execution/validate-execution-plan.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm test:unit",
    "test:unit": "node scripts/quality/run-required-suite.mjs unit",
    "test:integration": "node scripts/quality/run-required-suite.mjs integration",
    "test:contract": "node scripts/quality/run-required-suite.mjs contract",
    "test:e2e:desktop": "pnpm --filter @kms/desktop test:e2e",
    "test:e2e:mobile": "pnpm --filter @kms/mobile test:e2e",
    "test:security": "vitest run --config tests/security/vitest.config.ts",
    "test:resilience": "pnpm -r test:resilience",
    "test:performance": "pnpm -r test:performance",
    "build": "node scripts/quality/run-required-suite.mjs build",
    "verify": "pnpm execution:check && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:unit && pnpm test:integration && pnpm test:contract && pnpm build",
    "verify:release": "pnpm verify && pnpm test:e2e:desktop && pnpm test:e2e:mobile && pnpm test:security && pnpm test:resilience && pnpm test:performance",
    "android": "expo run:android",
    "ios": "expo run:ios"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^10.7.0",
    "fastify": "^5.5.0",
    "fastify-plugin": "^5.0.0",
    "prettier": "^3.9.6",
    "protobufjs": "^8.7.1",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "expo": "~54.0.0",
    "expo-crypto": "~15.0.9",
    "expo-linking": "~8.0.12",
    "expo-secure-store": "~14.2.4",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.4"
  }
}
