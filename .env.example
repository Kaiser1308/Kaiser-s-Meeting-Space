# ── Base / Environment ──────────────────────────────────────────────
# Environment: development | test | staging | production
NODE_ENV=development
# API server port (default: 4310)
API_PORT=4310

# ── Database ────────────────────────────────────────────────────────
# PostgreSQL connection URL (required)
DATABASE_URL=postgresql://localhost:5432/kms
# Maximum connection pool size (default: 20)
DATABASE_MAX_CONNECTIONS=20
# Enable SSL for database connections: true | false (default: false)
DATABASE_SSL=false

# ── Redis ───────────────────────────────────────────────────────────
# Redis connection URL (required)
REDIS_URL=redis://localhost:6379
# Maximum retries for Redis operations (default: 3)
REDIS_MAX_RETRIES=3

# ── S3 / Object Storage ─────────────────────────────────────────────
# S3-compatible endpoint URL (optional for dev; required for prod)
S3_ENDPOINT=http://localhost:9000
# S3 bucket name (required when S3_ENDPOINT is set)
S3_BUCKET=kms-dev
# S3 region (default: us-east-1)
S3_REGION=us-east-1
# S3 access key (required when S3_ENDPOINT is set)
S3_ACCESS_KEY=minioadmin
# S3 secret key (required when S3_ENDPOINT is set)
S3_SECRET_KEY=minioadmin
# Force path-style addressing: true | false (default: false)
S3_FORCE_PATH_STYLE=false

# ── OIDC Authentication ─────────────────────────────────────────────
# OIDC issuer URL (required for auth)
OIDC_ISSUER_URL=
# OIDC client ID (required for auth)
OIDC_CLIENT_ID=
# OIDC client secret (required for auth; keep secret)
OIDC_CLIENT_SECRET=
# OIDC redirect URI after login
OIDC_REDIRECT_URI=

# ── AI Provider ──────────────────────────────────────────────────────
# Provider for minutes generation: mock | openai-compatible (default: mock)
AI_PROVIDER=mock
# OpenAI-compatible API base URL (required when AI_PROVIDER=openai-compatible)
AI_BASE_URL=
# API key for AI provider (keep secret)
AI_API_KEY=
# Model name for AI provider
AI_MODEL=

# ── Speech Provider ──────────────────────────────────────────────────
# Speech-to-text provider: deepgram | local (default: deepgram)
SPEECH_PROVIDER=deepgram
# Deepgram API key (required when SPEECH_PROVIDER=deepgram; keep secret)
DEEPGRAM_API_KEY=

# ── Translation Provider (optional) ──────────────────────────────────
# Translation provider: google | azure | deepl | openai
TRANSLATION_PROVIDER=

# ── Limits and Concurrency ──────────────────────────────────────────
# Maximum concurrent background jobs (default: 5)
MAX_CONCURRENT_JOBS=5
# Job timeout in milliseconds (default: 300000 = 5 min)
JOB_TIMEOUT_MS=300000
# Rate limit in requests per minute (default: 60)
RATE_LIMIT_RPM=60
# Maximum upload size in MB (default: 500)
MAX_UPLOAD_SIZE_MB=500

# ── Observability ────────────────────────────────────────────────────
# OpenTelemetry exporter endpoint (optional)
OTEL_EXPORTER_ENDPOINT=
# Sentry DSN for error reporting (optional; keep secret)
SENTRY_DSN=
# Log level: trace | debug | info | warn | error | fatal (default: info)
LOG_LEVEL=info

# ── Release ──────────────────────────────────────────────────────────
# Release/environment tag for observability
RELEASE_TAG=unknown
